# RobotX Pi agent — configuration template.
#
# Every value below is the BUILT-IN DEFAULT (bench mode: no backend, no ESP32,
# no motion), so an empty file is a valid bench configuration. It is NOT the V1
# robot configuration. The V1 values -- and where they differ from these
# defaults -- are in docs/operations/V1_PI_DEPLOYMENT.md, and are also noted
# below as "V1:".
#
# NEVER commit real secrets. `.env` is gitignored, but on a deployed robot the
# configuration lives outside the repository, in /etc/robotx/robotx-agent.env
# (root:root, mode 0600). The agent does not load any file by itself: systemd
# reads it (EnvironmentFile=, see deployment/robotx-agent.service).
#
# BLANK VALUES ARE NOT THE SAME AS ABSENT ONES. To use a default, delete the
# line or comment it out; never leave `NAME=` empty. In particular:
#   - an empty on/off setting reads as OFF: `ROBOTX_BACKEND_TLS_VERIFY=` turns
#     certificate checking off, `ROBOTX_SOCKET_ENABLED=` turns the backend link
#     -- and with it the engine-mode lock on /mission/start and /mission/resume
#     -- off;
#   - an empty `ROBOTX_COMMITMENT_STATE_PATH=` keeps the commitment marks in
#     memory only, so they are lost on every restart;
#   - an empty number stops the agent at startup (the optional coordinates,
#     ROBOTX_HOME_* and ROBOTX_LOCAL_ORIGIN_*, are the exception: empty = unset).
# Text values are compared exactly: `esp32`, not `ESP32`; `operator`, not
# `Operator`.

# --- Identity and logging ----------------------------------------------------
# Must equal the commissioned Robot.robotId EXACTLY (case-sensitive, not
# trimmed) -- the id the unit was registered under with
# POST /api/robots/commission. There is no default; the backend link refuses to
# start without it, and an unknown id is a silent disconnect.
#   V1: ROBOTX_ROBOT_ID=<commissioned-robot-id>
ROBOTX_ROBOT_ID=
ROBOTX_LOG_LEVEL=INFO

# --- Local HTTP API ----------------------------------------------------------
# Unauthenticated. Served by `venv/bin/python -m robotx.application` on this
# host:port. The default is this Pi only. Reaching it from another machine is
# an explicit choice: set this to the interface to expose -- 0.0.0.0 is every
# interface -- on a trusted network only.
#   V1: keep the default. Operators reach the API over SSH, on the Pi itself;
#   any other bind needs the API to be authenticated first (not in V1).
ROBOTX_API_HOST=127.0.0.1
ROBOTX_API_PORT=8000

# --- Agent loop --------------------------------------------------------------
ROBOTX_AGENT_HZ=10.0
ROBOTX_TELEMETRY_INTERVAL_S=1.5
ROBOTX_HEALTH_INTERVAL_S=2.0

# --- Camera (Raspberry Pi Camera Module 3) -----------------------------------
# Set ROBOTX_CAMERA_ENABLED=0 to run headless without a camera.
ROBOTX_CAMERA_ENABLED=1
ROBOTX_CAMERA_WIDTH=640
ROBOTX_CAMERA_HEIGHT=480
ROBOTX_CAMERA_FPS=20
ROBOTX_CAMERA_STALE_AFTER_S=2.0

# --- Perception --------------------------------------------------------------
ROBOTX_PERCEPTION_ENABLED=1
ROBOTX_DETECTION_HZ=2.0
# opencv (CPU-only, default) | yolo (needs ultralytics + torch) | auto
ROBOTX_DETECTION_BACKEND=opencv
ROBOTX_DETECTION_MIN_CONF=0.35
ROBOTX_YOLO_MODEL_PATH=yolov8n.pt
ROBOTX_DETECTION_INFERENCE_WIDTH=320
ROBOTX_DETECTION_INFERENCE_HEIGHT=240
ROBOTX_PERCEPTION_STALE_AFTER_S=3.0

# Detector tuning (OpenCV backend). Adjust on the bench, against your camera
# mounting — the defaults are not calibrated for any particular robot.
ROBOTX_MOG2_HISTORY=250
ROBOTX_MOG2_VAR_THRESHOLD=32
ROBOTX_MOG2_WARMUP=20
ROBOTX_MOG2_MIN_AREA=4000
ROBOTX_MIN_MOTION_RATIO=0.001
ROBOTX_STATIC_CANNY1=60
ROBOTX_STATIC_CANNY2=160
ROBOTX_STATIC_MIN_AREA=2000
ROBOTX_EQUALIZE=1

# --- GPS ---------------------------------------------------------------------
# Where the rover's position comes from (exact, lowercase):
#   pi_serial -- an NMEA receiver on the Pi's own UART, ROBOTX_GPS_PORT (default)
#   esp32     -- the receiver on the ESP32's I2C bus, reported in the ESP32's
#                GPS frames; needs ROBOTX_ESP32_ENABLED=1. ROBOTX_GPS_PORT is
#                then not opened at all.
# Anything else (`ESP32`, `esp32 `) silently means pi_serial.
#   V1: ROBOTX_GPS_ENABLED=1 and ROBOTX_GPS_SOURCE=esp32. Do NOT disable GPS:
#   with no measured fix every OFFER is rejected (NO_POSITION_FIX).
ROBOTX_GPS_ENABLED=1
ROBOTX_GPS_SOURCE=pi_serial
# Used only with ROBOTX_GPS_SOURCE=pi_serial. On a Pi 5, /dev/serial0 may point
# at a different UART than /dev/ttyAMA0. A pi_serial GPS on the ESP32's port is
# refused (logged CRITICAL as gps.port_conflict) and leaves the rover with no
# position.
ROBOTX_GPS_PORT=/dev/ttyAMA0
ROBOTX_GPS_BAUDRATE=9600
ROBOTX_GPS_TIMEOUT_S=1.0
ROBOTX_GPS_STALE_AFTER_S=5.0
ROBOTX_GPS_RECONNECT_INTERVAL_S=5.0

# --- ESP32 link ----------------------------------------------------------------
# The UART to the ESP32 motor/sensor controller (protocol v2, see PROTOCOL.md).
# Name the port explicitly: /dev/serial0 is the debug connector on this Pi and
# is refused. ROBOTX_ESP32_PORT is reserved for the ESP32 whether or not the
# link is enabled: the agent will not start a pi_serial GPS on that device. The
# ESP32 is wired to /dev/ttyAMA0; its GPS reaches the Pi over this same link
# (ROBOTX_GPS_SOURCE=esp32, above).
#   V1: ROBOTX_ESP32_ENABLED=1, ROBOTX_ESP32_PORT=/dev/ttyAMA0 (confirm on the
#   device which node is the GPIO 14/15 UART).
ROBOTX_ESP32_ENABLED=0
ROBOTX_ESP32_PORT=/dev/ttyAMA0
ROBOTX_ESP32_BAUDRATE=115200
# 0 = receive-only: the Pi never writes to the ESP32.
# 1 = the link may send the documented resync LF and a PING per connection.
ROBOTX_ESP32_TRANSMIT_ENABLED=1
# 0 = no STOP/DRIVE is ever sent, and every OFFER is rejected (NO_MOTOR_LINK).
# Leave 0 until motion testing is authorised.
#   V1: 0 at installation; 1 only after the safe-motion-enablement step of
#   docs/operations/V1_PI_DEPLOYMENT.md.
ROBOTX_ESP32_MOTION_ENABLED=0
ROBOTX_ESP32_STALE_AFTER_S=1.0
ROBOTX_ESP32_ACK_TIMEOUT_S=0.5
# A motion command not written within this is dropped. At most 1.0 (enforced).
ROBOTX_ESP32_COMMAND_MAX_AGE_S=0.3
ROBOTX_ESP32_RECONNECT_MAX_S=10.0
# Software-only test runs (Gate 3): the ESP32 repository's host simulator
# executable stands in for the UART, and no serial device is opened.
# NEVER set this on a real robot: it would accept real OFFERs and "drive" the
# simulator while the rover stands still. Absent = the real UART (default).
# The agent logs `esp32.simulated` at WARNING whenever it is set.
# ROBOTX_ESP32_SIMULATOR_EXE=

# --- Custody -------------------------------------------------------------------
# How a parcel handover is known (exact, lowercase):
#   none     -- nothing on this rover can observe one, so every OFFER is
#               rejected (NO_CUSTODY_SENSING) (default)
#   operator -- the person at the stop confirms each handover through the local
#               API (POST /mission/custody), recorded as OPERATOR_CONFIRMED
#   V1: ROBOTX_CUSTODY_CONFIRMATION=operator
ROBOTX_CUSTODY_CONFIRMATION=none

# --- Position / heading ------------------------------------------------------
# There is no compass on this robot; heading comes from GPS movement only.
ROBOTX_HEADING_MIN_MOVE_M=1.5
ROBOTX_HEADING_MIN_SPEED_MPS=0.5

# --- Navigation --------------------------------------------------------------
ROBOTX_NAV_WAYPOINT_ARRIVAL_M=8.0
# Half-width of the corridor around the route: how far (m) the robot may be from
# the segment it is driving -- previous waypoint to next, measured sideways, or
# past the segment's end -- before that counts as off-route evidence. It is not a
# distance to the next waypoint: a long segment is legitimately far from its end.
ROBOTX_NAV_OFF_ROUTE_M=25.0
ROBOTX_NAV_REROUTE_AFTER_N=8
ROBOTX_NAV_BLOCKED_REROUTE_AFTER_N=3
ROBOTX_NAV_TARGET_SPEED_MPS=0.25

# --- Decision / motion intent ------------------------------------------------
# Normalized [0..1] velocities. NOT PWM or duty cycle: converting these to
# hardware units is the motor controller's job.
ROBOTX_MOTION_CRUISE_SPEED=0.45
ROBOTX_MOTION_TURN_SPEED=0.35
ROBOTX_MOTION_SLOW_SPEED=0.25
ROBOTX_MOTION_MAX_SPEED=0.75
# Obstacle sizes in px^2 of bounding-box area (a proxy for "close", not metres).
ROBOTX_OBSTACLE_STOP_AREA_PX=30000
ROBOTX_OBSTACLE_SLOW_AREA_PX=10000
ROBOTX_OBSTACLE_MIN_AREA_PX=1500
ROBOTX_OBSTACLE_CENTER_ZONE_RATIO=0.33
ROBOTX_STEERING_FULL_SCALE_DEG=45.0

# --- Local frame / dead reckoning ---------------------------------------------
# Lets the rover navigate with NO GPS by integrating the motion it commanded
# into a local metres frame. Open loop: nothing corrects it, so the estimate
# drifts without bound — wheel slip, a stalled motor and a sagging battery are
# all invisible to it. Good enough for a short indoor run, not a measurement.
# Every position it produces is labelled DEAD_RECKONING end to end.
ROBOTX_DEADRECKON_ENABLED=0

# Lat/lon the local frame is pinned to. Leave unset for an indoor demo: the
# rover then reports itself near (0, 0), which is obviously not a real place —
# exactly the impression a synthetic origin should give. Set it to the real
# coordinates of your start point if you want the dashboard pin to land there.
# ROBOTX_LOCAL_ORIGIN_LAT=
# ROBOTX_LOCAL_ORIGIN_LON=

# CALIBRATE THESE ON THE REAL ROVER — they are the entire motion model, and the
# defaults are placeholders. Uncalibrated, the pose is wrong by a large factor,
# not a small one.
#   max speed: drive straight at a known normalized speed for a measured time
#              over a measured distance, then solve for m/s at 1.0.
#   turn rate: command a rotation for a measured time, measure the angle swept.
ROBOTX_DEADRECKON_MAX_SPEED_MPS=0.4
ROBOTX_DEADRECKON_TURN_RATE_DPS=90.0
# Steps longer than this are discarded rather than integrated: a long gap means
# the loop stalled, and the last intent does not describe those seconds.
ROBOTX_DEADRECKON_MAX_STEP_S=0.5

# A dead-reckoned position is NEVER published to the backend; there is no
# switch for it. It is integrated from commanded motion around a configured
# origin, which is not a measurement of where the rover is.

# --- Safety gate -------------------------------------------------------------
# The last check a motion intent passes before it may leave the Pi. These are
# separate from the decision limits above on purpose: the gate exists to catch
# a mis-set or buggy decision layer, which it could not do if it read the same
# numbers. It can only ever reduce motion, never create it.

# Hard speed ceiling. An intent above this is scaled down, not rejected.
ROBOTX_SAFETY_MAX_SPEED=0.75
# An intent older than this describes a world that has moved on, so it is
# refused. At the default 5 Hz loop a healthy intent is ~0.2 s old.
ROBOTX_SAFETY_MAX_INTENT_AGE_S=1.0
# Measured forward range at or inside which motion is refused outright.
ROBOTX_SAFETY_STOP_DISTANCE_CM=30.0
# Whether a forward range sensor must be present AND reporting for the rover to
# move. Leave 0 until one is actually wired: this rover has no working range
# sensor yet, and turning this on before then just means it never moves. Once a
# sensor exists, set it to 1 — from then on a silent sensor stops the robot
# instead of being read as "path clear".
ROBOTX_SAFETY_REQUIRE_RANGE_SENSOR=0

# --- Health ------------------------------------------------------------------
ROBOTX_HEALTH_CPU_WARN_PERCENT=90.0
ROBOTX_HEALTH_MEMORY_WARN_PERCENT=90.0
ROBOTX_HEALTH_TEMP_WARN_C=80.0

# --- Backend link (FalconAut dashboard, over Socket.IO) ----------------------
# Off by default. The agent runs standalone and never needs a backend; with
# this at 0 the `socketio` library is not even imported.
# With it at 1, RobotX admits missions: POST /mission/start and
# POST /mission/resume answer 409 (the engine-mode lock). An empty value is 0.
#   V1: ROBOTX_SOCKET_ENABLED=1
ROBOTX_SOCKET_ENABLED=0
# Where the backend is. No default: required when ROBOTX_SOCKET_ENABLED=1, and
# the link refuses to start without it. The backend is never on this Pi.
#   Laptop on the LAN (local development):  http://<LAPTOP-LAN-IP>:<PORT>
#   Deployed backend:                       https://<backend-host>
#   V1: the deployed backend's https:// URL.
# A missing or malformed URL does not stop the agent: it runs with the link
# DISABLED (logged as backend.config_invalid). Check GET /backend after starting.
ROBOTX_SOCKET_SERVER_URL=
# Read but has no effect: the link reconnects on its own backoff regardless.
ROBOTX_SOCKET_RECONNECT=1
# ROBOTX_SOCKET_NAMESPACE is also read but has no effect: the protocol binding
# uses the backend's default namespace. Do not set it.

# --- FalconAut commissioning and credentials ---------------------------------
# The Socket.IO connection itself is ANONYMOUS: no handshake auth, no query
# credential. The robot authenticates by emitting AUTH after connecting.
#
# FIRST PAIRING ONLY. The 6-digit code from POST /api/robots/commission, which
# expires after 300 seconds. On a deployed robot it goes in its own file,
# /etc/robotx/pairing.env, which is deleted once AUTH succeeds -- see
# docs/operations/V1_PI_DEPLOYMENT.md. A code left configured is retried every
# 60 s if the stored token is ever rejected, and five failed attempts lock
# pairing for this robot.
# SECRET — never put a value in this file.
# ROBOTX_PAIRING_CODE=
#
# After the first AUTH_SUCCESS the session token is persisted here (mode 0600,
# directory 0700) and the pairing code is no longer needed. Delete the token
# file to force re-pairing. The default resolves against the service user's
# home directory.
#   V1: ROBOTX_BACKEND_TOKEN_PATH=/var/lib/robotx/backend_session.json
ROBOTX_BACKEND_TOKEN_PATH=~/.robotx/backend_session.json
#
# An explicit session token, overriding the stored one. Leave unset: a token set
# here is never discarded, even after the backend rejects it.
# SECRET — never put a value in this file.
# ROBOTX_ROBOT_TOKEN=
#
# How long to wait for AUTH_SUCCESS before treating the attempt as failed.
# Only AUTH_FAILED {reason: INVALID_CREDENTIAL} discards the stored token; a
# timeout or a silent disconnect keeps it and retries.
ROBOTX_BACKEND_AUTH_TIMEOUT_S=10.0

# The backend's COMMAND_SIGNING_KEY, used to verify signed Assignment Engine
# envelopes (OFFER, WITHDRAW, RECALL, ...). SECRET — never put a value in this
# file. Both sides use the UTF-8 bytes of the string exactly as written (at
# least 32 bytes), so the Pi's value must equal the backend's character for
# character. Generate it once, as hex only, with `openssl rand -hex 32` (64
# characters: no quotes, spaces, `#`, `$` or backslashes for any parser to
# reinterpret). The backend has NO mechanism to provision it; it can only be
# copied here out of band. It is fleet-wide and symmetric: anyone who reads it
# off this SD card can forge commands for every robot. Unset = no OFFER is ever
# admitted (verification is never skipped).
#   V1: ROBOTX_COMMAND_SIGNING_KEY=<the backend's COMMAND_SIGNING_KEY>
# ROBOTX_COMMAND_SIGNING_KEY=
#
# Commitment fence/sequence high-water marks, tombstones and the record of each
# OFFER already answered. Must survive restarts: engine delivery is
# at-least-once. NEVER leave this empty -- an empty value keeps them in memory
# only, and a restart then forgets which OFFERs were already answered.
#   V1: ROBOTX_COMMITMENT_STATE_PATH=/var/lib/robotx/commitments.json
ROBOTX_COMMITMENT_STATE_PATH=~/.robotx/commitments.json

# Optional. JSON file overriding individual FalconAut event names. The built-in
# binding follows the contract (AUTH / AUTH_SUCCESS / COMMAND / STOP); this is
# how you correct any name the backend spells differently, with no code change.
# See docs/communication/ROBOT_BACKEND_PROTOCOL.md for the file format.
# ROBOTX_PROTOCOL_FILE=/etc/robotx/protocol.json

# Outbound rates. Telemetry is the only high-frequency channel; at 1 Hz it is
# already 20x below the camera. Do NOT raise it to camera FPS.
ROBOTX_BACKEND_TELEMETRY_INTERVAL_S=1.0
# Liveness, ~every 2s. Sent whenever the link is authenticated, INCLUDING when
# there is no GPS fix and therefore no telemetry at all. Without it a healthy
# indoor robot looks identical to a crashed one.
# Y4: at most 2.0 (and above 0) or the link is not started -- the backend renews
# the mission's lease only on a heartbeat, and the link-loss pause relies on it.
ROBOTX_BACKEND_HEARTBEAT_INTERVAL_S=2.0
ROBOTX_BACKEND_STATUS_INTERVAL_S=5.0
# A position older than this is not published as live telemetry at all.
ROBOTX_BACKEND_MAX_POSITION_AGE_S=5.0
# Inbound commands older than this are rejected instead of acted on.
ROBOTX_BACKEND_COMMAND_MAX_AGE_S=120.0

ROBOTX_BACKEND_BACKOFF_INITIAL_S=1.0
ROBOTX_BACKEND_BACKOFF_MAX_S=60.0
# Verify the server's TLS certificate. Setting this to 0 makes the token
# interceptable — lab use with a self-signed certificate only. An EMPTY value
# also means 0: never leave it blank.
#   V1: ROBOTX_BACKEND_TLS_VERIFY=1
ROBOTX_BACKEND_TLS_VERIFY=1

# What an active mission does when the backend link is lost:
#   pause    — suspend the mission after the grace period (default)
#   continue — keep driving; the link is not a safety interlock
# Neither can ever start motion, and a paused mission is never resumed by the
# link coming back.
# Y4: with the backend link enabled only `pause` is accepted, with a grace of at
# most 10 s, so the robot pauses before its lease can be reassigned. A refused
# value leaves the agent running with the backend link NOT started (logged as
# backend.config_invalid).
#   V1: pause, 10.0
ROBOTX_BACKEND_LOSS_POLICY=pause
ROBOTX_BACKEND_LOSS_GRACE_S=10.0

# --- Home position -----------------------------------------------------------
# Where a backend RETURN command sends the robot. With neither this nor a
# GPS fix recorded at mission start, RETURN is REFUSED rather than guessed.
#   V1: leave unset, and do not send RETURN during an engine mission: RETURN
#   abandons the mission it interrupts.
# ROBOTX_HOME_LAT=
# ROBOTX_HOME_LON=

# --- Optional online routing -------------------------------------------------
# Not used by the agent today: nothing constructs a Directions client, so these
# three settings have no effect.
# SECRET — never put a value in this file.
# ROBOTX_GOOGLE_MAPS_API_KEY=
ROBOTX_DIRECTIONS_MIN_INTERVAL_S=15.0
ROBOTX_DIRECTIONS_CACHE_TTL_S=300.0

# --- Bench hardware (ESP32-owned in the target architecture) -----------------
# Used only by tests/hardware/* and the retained legacy direct-drive loop.
# The Pi agent never drives these.
ROBOTX_MOTOR_LEFT_IN1=5
ROBOTX_MOTOR_LEFT_IN2=6
ROBOTX_MOTOR_LEFT_ENA=12
ROBOTX_MOTOR_RIGHT_IN3=13
ROBOTX_MOTOR_RIGHT_IN4=19
ROBOTX_MOTOR_RIGHT_ENB=18
ROBOTX_MOTOR_PWM_HZ=1000
ROBOTX_MAX_MOTOR_DUTY=0.75
ROBOTX_ENCODER_LEFT_PIN=23
ROBOTX_ENCODER_RIGHT_PIN=24
ROBOTX_ENCODER_PULSES_PER_REV=20
ROBOTX_WHEEL_DIAMETER_M=0.065
ROBOTX_ULTRASONIC_TRIGGER_PIN=20
ROBOTX_ULTRASONIC_ECHO_PIN=21
ROBOTX_ULTRASONIC_POLL_HZ=10.0
ROBOTX_IR_LEFT_PIN=16
ROBOTX_IR_RIGHT_PIN=26
ROBOTX_IR_CENTER_PIN=25
ROBOTX_IR_ACTIVE_LOW=1
